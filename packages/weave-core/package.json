{
  "name": "@weavecode/core",
  "version": "0.1.0",
  "description": "Core types, schemas, and utilities for weave",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "development": "./src/harness.ts",
      "import": "./dist/harness.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "author": "zijing66",
  "license": "Apache-2.0",
  "keywords": [
    "claude",
    "claude-code",
    "harness",
    "mcp",
    "skills"
  ],
  "homepage": "https://github.com/zijing66/weave#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zijing66/weave.git"
  },
  "bugs": {
    "url": "https://github.com/zijing66/weave/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc && node ../../scripts/minify-dist.mjs dist",
    "prepack": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
