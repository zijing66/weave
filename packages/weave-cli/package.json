{
  "name": "@weavecode/cli",
  "version": "0.1.4",
  "private": true,
  "description": "CLI entry point for weave — parser, commands, and init executor",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "weave": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "THIRD_PARTY_NOTICES.md"
  ],
  "author": "zijing66",
  "license": "Apache-2.0",
  "keywords": [
    "claude",
    "claude-code",
    "harness",
    "mcp",
    "skills"
  ],
  "homepage": "https://github.com/zijing66/weave#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zijing66/weave.git"
  },
  "bugs": {
    "url": "https://github.com/zijing66/weave/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc && node ../../scripts/minify-dist.mjs dist",
    "prepack": "pnpm build",
    "test": "vitest run",
    "dev": "tsx watch --conditions=development src/main.ts"
  },
  "dependencies": {
    "@weavecode/core": "workspace:^",
    "@weavecode/harness": "workspace:^",
    "@weavecode/server": "workspace:^",
    "@weavecode/templates": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
