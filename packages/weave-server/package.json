{
  "name": "@weavecode/server",
  "version": "0.1.3",
  "private": true,
  "description": "Weave daemon — HTTP server, SQLite data layer, and hook ingestion",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "web/dist"
  ],
  "sideEffects": false,
  "author": "zijing66",
  "license": "Apache-2.0",
  "keywords": [
    "claude",
    "claude-code",
    "harness",
    "daemon",
    "sqlite"
  ],
  "homepage": "https://github.com/zijing66/weave#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zijing66/weave.git"
  },
  "bugs": {
    "url": "https://github.com/zijing66/weave/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc && node ../../scripts/minify-dist.mjs dist",
    "prepack": "pnpm build && pnpm build:web",
    "test": "vitest run",
    "build:web": "cd web && tsc && vite build",
    "dev:web": "cd web && vite"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@weavecode/core": "workspace:^",
    "@weavecode/harness": "workspace:^",
    "@weavecode/templates": "workspace:^",
    "chokidar": "^4.0.0",
    "selfsigned": "^5.5.0",
    "smol-toml": "^1.3.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-virtual": "^3.14.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.12.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "highlight.js": "^11.12.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.460.0",
    "mermaid": "^12.2.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.0",
    "vite": "^5.4.11",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
