{
  "name": "@weavecode/templates",
  "version": "0.1.0",
  "description": "Weave built-in resource repository (marketplace-shaped): packs, rule packs, and init assets",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "author": "zijing66",
  "license": "Apache-2.0",
  "keywords": [
    "claude",
    "claude-code",
    "harness",
    "mcp",
    "skills"
  ],
  "homepage": "https://github.com/zijing66/weave#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zijing66/weave.git"
  },
  "bugs": {
    "url": "https://github.com/zijing66/weave/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc && node copy-templates.mjs",
    "prepack": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@weavecode/core": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
