<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>weave-pet-window</AssemblyName>
    <RootNamespace>WeavePetWindow</RootNamespace>
    <!-- 产物自包含体积大；weave 分发只带框架依赖形态（本机需 .NET 8 Desktop Runtime +
         WebView2 Runtime，均为 Win10/11 常规组件），发布时再裁剪。 -->
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
